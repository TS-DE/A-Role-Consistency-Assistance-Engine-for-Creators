# ══════════════════════════════════════════════════════════════════
# 复制为 .env 后填真实值。.env 已被 .gitignore 忽略。
# 代码里统一通过 EnvLoader 读取，禁止在源码里硬编码 key。
# ══════════════════════════════════════════════════════════════════

# ── 模型选型（2026-10-27 定，冻结）───────────────────────────
# 原则：**一个模型 = 一台仪器**。中途换模型，之前所有数字都不能并排比较。
# 冻结策略：全项目用同一个模型，直到结业。
#
# 为什么不用本地 Ollama：
#   本机 i5 核显 + 内存吃紧，qwen3:4b 已占 80% CPU；判定器一轮 136 次调用
#   约需 1.5–3 小时，且期间机器不可用，无法迭代。
#
# 为什么不用 qwen3.8-27b：免费额度仅剩 5.53%，一轮全量约 20 万 tokens，不够跑完。

# ── 判定模型（判 OOC，项目核心）────────────────────────────
# 选它的理由：qwen 家族（与既有 94.1% 基线同家族，行为最接近）、免费额度 35 天、
# 比 27b 更强。判定是分类+引证任务，能力比价格重要 —— 判官抖一次，白跑一轮。
JUDGE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
JUDGE_API_KEY=sk-xxxxxxxxxxxxxxxx
JUDGE_MODEL=qwen3.8-max-0902

# ── 生成模型（写福尔摩斯的回复，W1 闭环节点用）─────────────
# 先与判定器同模型（一个仪器，数字可比）。
# 若后面发现生成"通义味"重、英式语感不够，再单独换成 deepseek-v4-pro-0813，
# 但换的那天起，生成侧的质量结论要重测。
LLM_PROVIDER=qwen
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=qwen3.8-max-0902
# 温度键说明（2026-10-29 实测修正）：LLM_TEMPERATURE / JUDGE_TEMPERATURE 此前是"死键"——
# urllib 后端把请求体 temperature 硬编码 0.0，本键从未生效；现已接上。
# 代码兜底默认均为 0.0（与接线前的实际生效值一致）；留空=0.0。判定侧建议保持 0.0。
LLM_TEMPERATURE=0.8
JUDGE_TEMPERATURE=0.0

# ── 备用后端：本地 Ollama（不推荐用于评测，仅供断网时冒烟测试）──
# 先把模型目录挪出 C 盘（否则 C 盘会彻底写满）：
#   setx OLLAMA_MODELS D:\ollama-models
# 然后重启 ollama。切换时改这三行即可：
# JUDGE_BASE_URL=http://localhost:11434/v1
# JUDGE_API_KEY=ollama
# JUDGE_MODEL=qwen3:4b

# ── 向量化（W2 用）───────────────────────────────────
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ── 检索参数（W2 调参用）─────────────────────────────
RETRIEVE_TOP_K=5
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5
RRF_K=60

# ── 流程控制 ─────────────────────────────────────────
MAX_REWRITE_ATTEMPTS=3

# ── 多专家判定模式 ───────────────────────────────────
# simple=单节点并行直判（旧路径）；blackboard=8 专家写板 + 裁决者读板
# 未知取值会显式报错中止（不静默回退），防止"以为开了黑板其实没开"。
AGENT_MODE=blackboard

# ── 落句级统一裁决（仅 blackboard 模式有意义）────────
# on=裁决只认「落句+严重度」，一个落句桶最多贡献一处命中，pattern/轴归属摇摆不动分数（默认）
# off=逐字节回 v0.9.1（A/B 基线与故障回退位）。未知取值显式报错。
ARBITER_MERGE=on

# ── 成本口径（写报告要用）─────────────────────────────
# 一轮全量 fanout = 17 候选 × 8 trait = 136 次调用 ≈ 20 万 tokens
# 免费 1M 额度 ≈ 5 轮；超出后按各家 flash/max 单价计费，单轮通常 < 2 元
