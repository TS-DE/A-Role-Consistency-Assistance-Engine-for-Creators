# 复制为 .env 后填真实值。.env 已被 .gitignore 忽略。
# 代码里统一通过 os.getenv 读取，禁止在源码里硬编码 key。

# ── 生成模型（写福尔摩斯的回复）────────────────────────
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_TEMPERATURE=0.8

# ── 校验模型（判 OOC）────────────────────────────────
# 建议与生成用不同模型/不同 temperature：
# 同模型自检容易"自我认同"，校验会失效（ADR-004 里讨论）
JUDGE_API_KEY=sk-xxxxxxxxxxxxxxxx
JUDGE_MODEL=deepseek-chat
JUDGE_TEMPERATURE=0.0

# ── 向量化 ──────────────────────────────────────────
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# ── 检索参数（W2 调参用）────────────────────────────
RETRIEVE_TOP_K=5
BM25_WEIGHT=0.5
VECTOR_WEIGHT=0.5
RRF_K=60

# ── 流程控制 ────────────────────────────────────────
MAX_REWRITE_ATTEMPTS=3
